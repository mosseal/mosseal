# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# WASM build artifacts
pkg/
crates/mosseal-wasm/pkg/
crates/mosseal-wasm/target/
packages/mosseal/template/pkg/
packages/mosseal/template/target/
packages/mosseal/template/mosseal-core-*/
# Conformance wasm built on demand by the Node + browser suites (spec 08)
packages/core/test/fixtures/conformance-wasm/
packages/core/test/fixtures/conformance-wasm-web/
packages/core/test/fixtures/conformance-wasm-web-strict/
packages/core/test/fixtures/conformance-wasm-web-custom/
# Playwright browser-suite build output + reports (spec 08).
# NOTE: e2e/harness/*.js|*.html are SOURCE (tracked); only the bundle is ignored.
packages/core/e2e/.dist/
packages/core/test-results/
packages/core/playwright-report/

# Node / frontend
node_modules/
dist/
.vite/
*.tsbuildinfo
.parcel-cache/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
*.pem
*.key

# Generated secrets.rs — the CLI builder (`mosseal build`, spec 05) writes
# obfuse-encrypted epoch secrets into this file. The committed placeholder
# (crates/mosseal-wasm/src/secrets.rs) must stay in git; any GENERATED copy
# containing real secrets must never be committed. The builder writes into
# its template copy, but guard every location just in case:
packages/mosseal/template/src/secrets.rs
**/template/src/secrets.rs
mosseal-out/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS
.DS_Store
Thumbs.db

# Coverage / profiling
*.profraw
coverage/
