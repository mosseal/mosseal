  "description": "CLI builder for MOSSEAL: validates env, injects secrets via Rust codegen, and compiles the per-consumer wasm (spec 05).",
  "type": "module",
  "bin": {
    "mosseal": "./dist/mosseal.js"
  },
  "files": [
    "dist/",
    "template/"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
